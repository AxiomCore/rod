# to ensure consistent builds across all contributors.

# --- JavaScript & TypeScript (languages/js) ---
node_modules/
/languages/js/dist/
/languages/js/wasm/
/languages/js/package-lock.json

# --- Python (languages/python) ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
/languages/python/dist/
/languages/python/build/
/languages/python/*.egg-info/
