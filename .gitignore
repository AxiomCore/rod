/languages/python/rod/*.so
/languages/python/rod/*.pyd
/languages/python/rod/*.dylib

# --- Python Virtual Environments ---
.venv/
venv/
ENV/

# --- WASM Bindings (bindings/rod-wasm) ---
/bindings/rod-wasm/pkg/

